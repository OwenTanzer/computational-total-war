{
  "name": "computational-total-war",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-readable Total War: Warhammer III context for AI agents, with reproducible datasets and validation scripts.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "npm run validate:units && npm run validate:skills && npm run validate:economy && npm run validate:campaign && npm run validate:technologies",
    "validate:units": "node scripts/validate-unit-dataset.mjs data/unit_stats/source_exports data/unit_stats",
    "validate:skills": "node scripts/validate-skill-trees.mjs data/skill_trees/source_exports data/skill_trees",
    "validate:economy": "node scripts/validate-economy-dataset.mjs data/economy/source_exports data/economy",
    "validate:campaign": "node scripts/validate-campaign-atlas.mjs data/campaign_map/campaign_atlas__wh3__8.1.1.gpkg data/campaign_map",
    "extract:technologies": "node scripts/extract-technology-source.mjs",
    "build:technologies": "node scripts/build-technology-trees.mjs",
    "validate:technologies": "node scripts/validate-technology-trees.mjs data/technology_trees/source_exports data/technology_trees",
    "test:technologies": "node scripts/test-technology-trees.mjs"
  },
  "license": "MIT"
}
