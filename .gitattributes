# Normalize repository text files across Windows, macOS, and Linux.
* text=auto

*.csv  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.tex  text eol=lf
*.tsv  text eol=lf
*.ps1  text eol=lf

# GeoPackages are SQLite databases and must never receive text conversion.
*.gpkg binary

# Most datasets are generated artifacts; keep them out of language statistics.
/data/**/*.csv linguist-generated=true
/data/**/*.tsv linguist-generated=true

# Technology artifacts and their raw Lua/TSV sources are hashed byte-for-byte.
# Preserve decoder/builder line endings on checkout so recorded hashes remain valid.
/data/technology_trees/** -text -whitespace
